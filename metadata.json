{
  "name": "mindhive-etcd",
  "version": "2.2.0",
  "author": "damon@mindhive.co.nz",
  "summary": "etcd server and client",
  "license": "MIT",
  "source": "https://github.com/mindhivenz/puppet-etcd",
  "project_page": "https://github.com/mindhivenz/puppet-etcd",
  "issues_url": "https://github.com/mindhivenz/puppet-etcd/issues",
  "dependencies": [
    {
      "name": "stm/openssl",
      "version_requirement": ">=4.1.0 <5.0.0"
    },
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">=4.24.0 <10.0.0"
    },
    {
      "name": "puppet/systemd",
      "version_requirement": ">= 3.8.0 < 9.0.0"
    },
    {
      "name": "puppet/archive",
      "version_requirement": ">= 4.0.0 < 9.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "20.04",
        "22.04",
        "24.04"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    }
  ],
  "tags": []
}
